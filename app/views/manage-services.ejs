<%- include('partials/head',{title:'Quản lý dịch vụ'}) %><main class="container admin-main">
<%- include('partials/manage-heading',{heading:'Dịch vụ',description:'Thiết lập nội dung tư vấn, thời lượng, giá và trạng thái cung cấp.',section}) %>
<div class="management-grid"><section class="form-card management-editor"><h2><%= edit?'Chỉnh sửa dịch vụ':'Thêm dịch vụ' %></h2><form class="manage-form" action="/api/admin/services<%= edit?'/'+edit.id:'' %>" data-return="/admin/services">
<label>Tên dịch vụ<input name="name" value="<%= edit?.name||'' %>" minlength="2" maxlength="100" required></label>
<label>Mô tả<textarea name="description" rows="4" minlength="5" maxlength="2000" required><%= edit?.description||'' %></textarea></label>
<div class="form-row"><label>Thời lượng (phút)<input name="durationMinutes" type="number" min="15" max="240" step="15" value="<%= edit?.duration_minutes||30 %>" required></label><label>Giá dịch vụ (VNĐ)<input name="price" type="number" min="0" max="100000000" step="1" value="<%= edit?.price??0 %>" required></label></div>
<label class="check-line"><input name="active" type="checkbox" value="true" <%= !edit||edit.active?'checked':'' %>> Đang cung cấp</label>
<p class="form-error" data-form-error role="alert" hidden></p><button type="submit" class="button primary full"><%= edit?'Lưu thay đổi':'Thêm dịch vụ' %> ↗</button><% if(edit){ %><a class="text-link" href="/admin/services">Hủy chỉnh sửa</a><% } %></form><p class="muted">Sau khi thêm dịch vụ, phân công nhân viên và tạo khung giờ. Khi đã có khung giờ mở, cần đóng chúng trước khi thay đổi thời lượng.</p></section>
<section class="admin-table-card"><div class="table-toolbar"><h2>Danh mục dịch vụ (<%= rows.length %>)</h2></div><div class="table-scroll"><table><thead><tr><th>Dịch vụ</th><th>Giá / thời lượng</th><th>Nhân viên</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% rows.forEach(s=>{ %><tr><td><strong><%= s.name %></strong><span class="cell-secondary"><%= s.description %></span></td><td><%= new Intl.NumberFormat('vi-VN').format(s.price) %> ₫<span class="cell-secondary"><%= s.duration_minutes %> phút</span></td><td><%= s.staff_count %></td><td><span class="status <%= s.active?'confirmed':'cancelled' %>"><%= s.active?'Đang cung cấp':'Đã ngừng' %></span></td><td><div class="manage-actions"><a class="action-button" href="/admin/services?edit=<%= s.id %>">Chỉnh sửa</a><% if(s.active){ %><button class="action-button manage-action" data-url="/api/admin/services/<%= s.id %>/archive" data-confirm="Ngừng cung cấp dịch vụ này? Lịch sử sẽ được giữ lại.">Ngừng cung cấp</button><% } %></div></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="5">Chưa có dịch vụ. Hãy thêm dịch vụ đầu tiên.</td></tr><% } %></tbody></table></div></section></div></main><%- include('partials/footer') %>
