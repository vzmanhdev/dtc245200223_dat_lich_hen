<%- include('partials/head',{title:mode==='register'?'Tạo tài khoản':'Đăng nhập'}) %>
<main class="login-layout container">
 <div class="login-intro"><p class="eyebrow">MẠNH CONSULTING · TƯ VẤN CÔNG NGHỆ</p><h1>Cuộc hẹn của bạn,<br>trong <em>tầm tay.</em></h1><p>Chọn chuyên viên phù hợp, đặt giờ tư vấn và theo dõi xác nhận trong tài khoản của bạn.</p><a class="text-link" href="/">← Khám phá dịch vụ</a></div>
 <section class="form-card login-card"><%- include('partials/login-roles',{role:'customer'}) %><p class="eyebrow">KHÔNG GIAN KHÁCH HÀNG</p><h2><%= mode==='register'?'Tạo tài khoản.':'Chào mừng trở lại.' %></h2>
 <% if(error){ %><p class="form-error" role="alert"><%= error %></p><% } %>
 <form method="post" action="/<%= mode %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
 <% if(mode==='register'){ %><label>Họ và tên<input name="fullName" autocomplete="name" minlength="2" maxlength="100" required></label><label>Số điện thoại<input name="phone" type="tel" autocomplete="tel" minlength="9" maxlength="20" required></label><% } %>
 <label>Email<input name="email" type="email" autocomplete="username" maxlength="200" required></label>
 <label>Mật khẩu<input name="password" type="password" autocomplete="<%= mode==='register'?'new-password':'current-password' %>" <%= mode==='register'?'minlength=12':'' %> maxlength="128" required></label>
 <% if(mode==='register'){ %><p class="muted">Dùng ít nhất 12 ký tự để bảo vệ tài khoản của bạn.</p><label>Nhập lại mật khẩu<input name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label><% } %>
 <button class="button primary full" type="submit"><%= mode==='register'?'Đăng ký':'Đăng nhập' %> ↗</button></form>
 <p class="muted"><%= mode==='register'?'Đã có tài khoản?':'Chưa có tài khoản?' %> <a class="text-link" href="/<%= mode==='register'?'login':'register' %>"><%= mode==='register'?'Đăng nhập':'Đăng ký ngay' %></a></p>

 </section>
</main><%- include('partials/footer') %>
