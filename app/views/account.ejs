<%- include('partials/head',{title:'Lịch hẹn của tôi'}) %>
<main class="container admin-main"><div class="admin-heading"><div><p class="eyebrow">KHÔNG GIAN KHÁCH HÀNG</p><h1>Lịch hẹn của tôi.</h1><p class="muted">Chào <%= customer.full_name %> · <%= customer.email %></p></div><a href="/#booking" class="button primary">Đặt lịch mới ↗</a></div>
<p>Chọn dịch vụ và chuyên viên → gửi yêu cầu → quản trị viên xác nhận lịch với chuyên viên bạn chọn. Giờ hiển thị theo Việt Nam (UTC+7).</p>
<div class="customer-appointments"><% appointments.forEach(a=>{ %><article class="form-card appointment-card"><div class="appointment-card-heading"><strong><%= a.booking_code %></strong><span class="status <%= a.status %>"><%= statusNames[a.status] %></span></div><h2><%= a.service_name %></h2><p>Chuyên viên: <strong><%= a.staff_name %></strong></p><p><%= formatDate(a.start_at) %> · <%= formatTime(a.start_at) %>–<%= formatTime(a.end_at) %></p><% if(a.status==='pending'){ %><p class="muted">Yêu cầu đã được tiếp nhận, đang chờ xác nhận.</p><% } %><% if(a.status==='confirmed'){ %><p class="muted">Lịch đã được xác nhận. Hãy có mặt đúng giờ để gặp chuyên viên.</p><% } %><% if(['pending','confirmed'].includes(a.status)&&new Date(a.start_at)>new Date()){ %><button class="button secondary cancel-owned" type="button" data-id="<%= a.id %>">Hủy lịch hẹn</button><% } %></article><% }) %></div>
<% if(!appointments.length){ %><div class="empty-state"><h2>Bạn chưa có lịch hẹn nào.</h2><p>Khám phá dịch vụ và chọn một chuyên viên để bắt đầu.</p><a class="button primary" href="/#booking">Đặt lịch đầu tiên ↗</a></div><% } %><section class="form-card profile-card"><h2>Thông tin cá nhân</h2><p class="muted">Thông tin liên hệ này được dùng cho lịch đặt mới.</p><form class="manage-form" action="/api/my/profile" data-return="/account"><div class="form-row"><label>Họ và tên<input name="fullName" value="<%= customer.full_name %>" minlength="2" maxlength="100" required></label><label>Số điện thoại<input name="phone" value="<%= customer.phone %>" minlength="9" maxlength="20" required></label></div><p class="muted"><%= customer.email %></p><p class="form-error" data-form-error role="alert" hidden></p><button type="submit" class="button secondary">Lưu thông tin</button></form></section></main>
<%- include('partials/footer') %>
