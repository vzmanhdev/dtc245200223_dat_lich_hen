<%- include('partials/head',{title:'Quản lý khung giờ'}) %><main class="container admin-main"><%- include('partials/manage-heading',{heading:'Khung giờ',description:'Mở lịch cho từng nhân viên. Mỗi khung giờ dành cho một khách hàng.',section}) %>
<div class="management-grid"><section class="form-card management-editor"><h2><%= edit?'Chỉnh sửa khung giờ':'Mở khung giờ' %></h2><form class="manage-form" action="/api/admin/slots<%= edit?'/'+edit.id:'' %>" data-return="/admin/slots">
<label>Dịch vụ<select name="serviceId" required><option value="">Chọn dịch vụ</option><% services.filter(s=>s.active||s.id===edit?.service_id).forEach(s=>{ %><option value="<%= s.id %>" <%= s.id===edit?.service_id?'selected':'' %>><%= s.name %> · <%= s.duration_minutes %> phút</option><% }) %></select></label>
<label>Nhân viên<select name="staffId" required><option value="">Chọn nhân viên đã phân công</option><% staff.filter(m=>m.active||m.id===edit?.staff_id).forEach(m=>{ %><option value="<%= m.id %>" <%= m.id===edit?.staff_id?'selected':'' %>><%= m.full_name %></option><% }) %></select></label>
<label>Bắt đầu (giờ Việt Nam)<input name="startAt" type="datetime-local" value="<%= edit?localTime(edit.start_at):date+'T09:00' %>" required></label>
<% if(!edit){ %><label>Cách tạo<select name="mode"><option value="single">Một khung giờ</option><option value="batch">Nhiều khung giờ liên tiếp</option></select></label><label>Kết thúc khoảng tạo lịch<input name="untilAt" type="datetime-local" value="<%= date+'T17:00' %>"></label><p class="muted">Chỉ dùng giờ kết thúc khi tạo nhiều khung. Thời lượng mỗi khung lấy từ dịch vụ. Toàn bộ khoảng tạo phải trống và cùng ngày.</p><% } %>
<p class="form-error" data-form-error role="alert" hidden></p><button class="button primary full" type="submit"><%= edit?'Lưu thay đổi':'Mở khung giờ' %> ↗</button><% if(edit){ %><a class="text-link" href="/admin/slots?date=<%= date %>">Hủy chỉnh sửa</a><% } %></form><p class="muted">Khung giờ đã có lịch sử đặt hẹn không được sửa thời gian để bảo toàn thông tin của khách.</p></section>
<section class="admin-table-card"><div class="table-toolbar"><h2>Lịch làm việc</h2><form method="get" class="filter-form"><label class="sr-only" for="slot-date">Ngày làm việc</label><input id="slot-date" type="date" name="date" value="<%= date %>" required><label class="sr-only" for="slot-staff">Nhân viên</label><select id="slot-staff" name="staffId"><option value="">Tất cả nhân viên</option><% staff.forEach(m=>{ %><option value="<%= m.id %>" <%= String(m.id)===String(staffId)?'selected':'' %>><%= m.full_name %></option><% }) %></select><button class="button secondary" type="submit">Xem lịch</button></form></div>
<div class="table-scroll"><table><thead><tr><th>Giờ</th><th>Nhân viên / dịch vụ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% rows.forEach(t=>{ %><tr><td><strong><%= formatTime(t.start_at) %>–<%= formatTime(t.end_at) %></strong><span class="cell-secondary"><%= formatDate(t.start_at) %></span></td><td><%= t.staff_name %><span class="cell-secondary"><%= t.service_name %></span></td><td><span class="status <%= !t.is_open?'cancelled':t.booked?'pending':'confirmed' %>"><%= !t.is_open?'Đã đóng':t.booked?'Đã có khách':'Đang mở' %></span></td><td><div class="manage-actions"><% if(!t.has_history){ %><a class="action-button" href="/admin/slots?date=<%= date %>&edit=<%= t.id %>">Chỉnh sửa</a><% } %><% if(new Date(t.start_at)>new Date()&&!t.booked){ %><button class="action-button manage-action" data-url="/api/admin/slots/<%= t.id %>/open" data-open="<%= !t.is_open %>" data-confirm="<%= t.is_open?'Đóng':'Mở lại' %> khung giờ này?"><%= t.is_open?'Đóng lịch':'Mở lại' %></button><% } %></div></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="4"><div class="empty-state">Chưa có khung giờ trong ngày. Dùng form bên cạnh để mở lịch.</div></td></tr><% } %></tbody></table></div></section></div></main><%- include('partials/footer') %>
