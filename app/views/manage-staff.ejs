<%- include('partials/head',{title:'Quản lý nhân viên'}) %><main class="container admin-main"><%- include('partials/manage-heading',{heading:'Nhân viên',description:'Quản lý chuyên viên và phân công dịch vụ trước khi mở lịch làm việc.',section}) %>
<div class="management-grid"><section class="form-card management-editor"><h2><%= edit?'Chỉnh sửa nhân viên':'Thêm nhân viên' %></h2><form class="manage-form" action="/api/admin/staff<%= edit?'/'+edit.id:'' %>" data-return="/admin/staff">
<label>Họ và tên<input name="fullName" value="<%= edit?.full_name||'' %>" minlength="2" maxlength="100" required></label><label>Chức danh<input name="title" value="<%= edit?.title||'' %>" minlength="2" maxlength="120" required></label><label>Giới thiệu<textarea name="bio" rows="3" minlength="5" maxlength="2000" required><%= edit?.bio||'' %></textarea></label>
<fieldset class="assignment-options"><legend>Dịch vụ phụ trách</legend><% services.forEach(s=>{ %><label class="check-line"><input type="checkbox" name="serviceIds" value="<%= s.id %>" <%= edit?.service_ids.includes(s.id)?'checked':'' %>> <%= s.name %><%= s.active?'':' (đã ngừng)' %></label><% }) %></fieldset>
<label class="check-line"><input type="checkbox" name="active" value="true" <%= !edit||edit.active?'checked':'' %>> Đang nhận lịch</label><p class="form-error" data-form-error role="alert" hidden></p><button class="button primary full" type="submit"><%= edit?'Lưu thay đổi':'Thêm nhân viên' %> ↗</button><% if(edit){ %><a class="text-link" href="/admin/staff">Hủy chỉnh sửa</a><% } %></form></section>
<section class="admin-table-card"><div class="table-toolbar"><h2>Đội ngũ tư vấn (<%= rows.length %>)</h2></div><div class="table-scroll"><table><thead><tr><th>Nhân viên</th><th>Dịch vụ phụ trách</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% rows.forEach(m=>{ %><tr><td><strong><%= m.full_name %></strong><span class="cell-secondary"><%= m.title %></span><span class="cell-secondary"><%= m.bio %></span></td><td><%= services.filter(s=>m.service_ids.includes(s.id)).map(s=>s.name).join(', ')||'Chưa phân công' %></td><td><span class="status <%= m.active?'confirmed':'cancelled' %>"><%= m.active?'Đang nhận lịch':'Đã ngừng' %></span></td><td><div class="manage-actions"><a class="action-button" href="/admin/staff?edit=<%= m.id %>">Chỉnh sửa</a><a class="action-button" href="/admin/slots?staffId=<%= m.id %>">Lịch làm việc</a><% if(m.active){ %><button class="action-button manage-action" data-url="/api/admin/staff/<%= m.id %>/archive" data-confirm="Ngừng nhận lịch của nhân viên này?">Ngừng nhận lịch</button><% } %></div></td></tr><% }) %></tbody></table></div></section></div></main><%- include('partials/footer') %>
