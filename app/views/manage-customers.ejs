<%- include('partials/head',{title:'Quản lý khách hàng'}) %><main class="container admin-main"><%- include('partials/manage-heading',{heading:'Khách hàng',description:'Tra cứu tài khoản, thông tin liên hệ và lịch sử đặt hẹn.',section}) %>
<% if(edit){ %><div class="management-grid customer-detail"><section class="form-card management-editor"><h2>Thông tin khách hàng</h2><p class="muted"><%= edit.email %></p><form class="manage-form" action="/api/admin/customers/<%= edit.id %>" data-return="/admin/customers?edit=<%= edit.id %>"><label>Họ và tên<input name="fullName" value="<%= edit.full_name %>" minlength="2" maxlength="100" required></label><label>Số điện thoại<input name="phone" value="<%= edit.phone %>" minlength="9" maxlength="20" required></label><label class="check-line"><input type="checkbox" name="active" value="true" <%= edit.active?'checked':'' %>> Cho phép đăng nhập và đặt lịch</label><p class="muted">Khóa tài khoản không tự hủy lịch đang có. Hãy xử lý lịch hẹn tại mục Lịch hẹn nếu cần.</p><p class="form-error" data-form-error role="alert" hidden></p><button class="button primary full" type="submit">Lưu thông tin ↗</button></form></section>
<section class="admin-table-card"><div class="table-toolbar"><h2>Lịch sử đặt hẹn</h2></div><div class="table-scroll"><table><thead><tr><th>Mã lịch</th><th>Dịch vụ</th><th>Thời gian</th><th>Trạng thái</th></tr></thead><tbody><% history.forEach(a=>{ %><tr><td><%= a.booking_code %></td><td><%= a.service_name_snapshot %></td><td><%= formatDate(a.start_at) %> <%= formatTime(a.start_at) %></td><td><span class="status <%= a.status %>"><%= statusNames[a.status] %></span></td></tr><% }) %><% if(!history.length){ %><tr><td colspan="4">Chưa có lịch hẹn.</td></tr><% } %></tbody></table></div></section></div><% } %>
<section class="admin-table-card"><div class="table-toolbar"><h2>Tài khoản khách hàng</h2><form method="get" class="filter-form"><label class="sr-only" for="customer-search">Tìm khách hàng</label><input id="customer-search" name="q" value="<%= q %>" placeholder="Tên, email, điện thoại" maxlength="100"><button class="button secondary" type="submit">Tìm kiếm</button><a href="/admin/customers" class="text-link">Tất cả</a></form></div><div class="table-scroll"><table><thead><tr><th>Khách hàng</th><th>Liên hệ</th><th>Số lịch</th><th>Tài khoản</th><th>Thao tác</th></tr></thead><tbody><% rows.forEach(c=>{ %><tr><td><strong><%= c.full_name %></strong></td><td><%= c.email %><span class="cell-secondary"><%= c.phone %></span></td><td><%= c.booking_count %></td><td><span class="status <%= c.active?'confirmed':'cancelled' %>"><%= c.active?'Hoạt động':'Đã khóa' %></span></td><td><a class="action-button" href="/admin/customers?edit=<%= c.id %>">Chi tiết / chỉnh sửa</a></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="5">Không có khách hàng phù hợp.</td></tr><% } %></tbody></table></div></section>
<% if(legacy.length){ %><section class="admin-table-card legacy-customers"><div class="table-toolbar"><h2>Khách đặt lịch trước khi có tài khoản</h2></div><div class="table-scroll"><table><thead><tr><th>Khách hàng</th><th>Liên hệ</th><th>Mã lịch</th><th>Trạng thái</th></tr></thead><tbody><% legacy.forEach(c=>{ %><tr><td><%= c.full_name %></td><td><%= c.phone %><span class="cell-secondary"><%= c.email %></span></td><td><%= c.booking_code %></td><td><%= statusNames[c.status] %></td></tr><% }) %></tbody></table></div></section><% } %></main><%- include('partials/footer') %>
